{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "eqeqeq": "error",
    "no-debugger": "error",
    "react/react-in-jsx-scope": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "eslint/no-await-in-loop": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "coverage",
    "playwright-report",
    "test-results",
    "node_modules"
  ],
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "tests/**/*.ts",
        "scripts/**/*"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
